generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Movie {
  id          String   @id @default(cuid())
  title       String
  description String
  posterUrl   String
  durationMin Int
  language    String
  certificate String
  shows       Show[]
  createdAt   DateTime @default(now())
}

model Screen {
  id       String @id @default(cuid())
  name     String
  capacity Int
  shows    Show[]
}

model Show {
  id        String    @id @default(cuid())
  movieId   String
  screenId  String
  startsAt  DateTime
  price     Int
  movie     Movie     @relation(fields: [movieId], references: [id])
  screen    Screen    @relation(fields: [screenId], references: [id])
  seats     Seat[]
  bookings  Booking[]
}

model Seat {
  id        String    @id @default(cuid())
  showId    String
  seatNo    String
  status    String    @default("AVAILABLE")
  show      Show      @relation(fields: [showId], references: [id])
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  @@unique([showId, seatNo])
}

model Booking {
  id          String    @id @default(cuid())
  userId      String
  showId      String
  amount      Int
  status      String    @default("PENDING")
  paymentId   String?
  bookedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  show        Show      @relation(fields: [showId], references: [id])
  seats       Seat[]
}